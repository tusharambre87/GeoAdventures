{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backfill:intelligence": "tsx src/planner/backfillIntelligence.ts",
    "backfill:logistics": "tsx src/planner/backfillLogistics.ts",
    "backfill:missions": "tsx src/planner/backfillMissions.ts",
    "backfill:explore": "tsx src/planner/backfillExploreContent.ts",
    "backfill:images": "tsx src/backfillImages.ts",
    "backfill:images-cities": "tsx src/backfillImagesCities.ts",
    "backfill:psi-cities": "tsx src/planner/runPsiCities.ts",
    "backfill:dc-stops": "tsx src/planner/addDcStops.ts",
    "backfill:psi-scores": "tsx src/planner/backfillPsiScores.ts",
    "backfill:landmarks": "tsx src/planner/seedLandmarkPhotos.ts",
    "backfill:landmarks:dc": "LANDMARK_CITY=\"Washington DC\" tsx src/planner/seedLandmarkPhotos.ts",
    "backfill:library-psi": "tsx src/planner/backfillLibraryPsi.ts",
    "backfill:pmal": "tsx src/planner/backfillPmal.ts",
    "backfill:google-places": "tsx src/scripts/backfill-google-places.ts",
    "backfill:recompute-gp-floor": "tsx src/scripts/recompute-gp-floor.ts",
    "backfill:recompute-gp-floor-cache-bust": "tsx src/scripts/recompute-gp-floor-cache-bust.ts",
    "backfill:pool-zones": "tsx src/planner/backfillPoolZones.ts",
    "backfill:stop-desc": "tsx src/planner/backfillStopDescriptions.ts",
    "script:tag-metro": "tsx src/scripts/tagMetroStops.ts",
    "seed:duluth": "tsx src/scripts/seed-duluth.ts",
    "seed:split-rock": "tsx src/scripts/seed-split-rock.ts",
    "seed:yellowstone": "tsx src/scripts/seed-yellowstone.ts",
    "seed:yosemite": "tsx src/scripts/seed-yosemite.ts",
    "dedup:gp-place-id": "tsx src/scripts/dedup-gp-place-id.ts",
    "dedup:gp-place-id:yellowstone": "DEDUP_CITY=Yellowstone tsx src/scripts/dedup-gp-place-id.ts",
    "dedup:norm-names": "tsx src/scripts/dedup-norm-names.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@sendgrid/mail": "^8.1.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.4",
    "memoizee": "^0.4.17",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^22.1.1",
    "stripe-replit-sync": "^1.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/marked": "^6.0.0",
    "@types/memoizee": "^0.4.12",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/passport": "^1.0.17",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.8"
  }
}
